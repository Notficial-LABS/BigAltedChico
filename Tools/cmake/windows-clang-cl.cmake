# SPDX-License-Identifier: MIT
# Host LLVM + xwin's Microsoft CRT/SDK. All downloaded dependencies stay local.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
set(LLVM_ROOT "$ENV{LLVM_ROOT}" CACHE PATH "Host LLVM installation")
set(LLD_ROOT "$ENV{LLD_ROOT}" CACHE PATH "Host LLD installation")
set(WINDOWS_SDK_ROOT "$ENV{WINDOWS_SDK_ROOT}" CACHE PATH "xwin splat output")
set(CMAKE_C_COMPILER "${LLVM_ROOT}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${LLVM_ROOT}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "${LLD_ROOT}/bin/lld-link")
set(CMAKE_AR "${LLVM_ROOT}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "${LLVM_ROOT}/bin/llvm-rc")
set(CMAKE_MT "${LLVM_ROOT}/bin/llvm-mt")
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LLVM_ROOT LLD_ROOT WINDOWS_SDK_ROOT)
set(CMAKE_FIND_ROOT_PATH "${WINDOWS_SDK_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(_windows_includes "/imsvc \"${WINDOWS_SDK_ROOT}/crt/include\" /imsvc \"${WINDOWS_SDK_ROOT}/sdk/include/ucrt\" /imsvc \"${WINDOWS_SDK_ROOT}/sdk/include/shared\" /imsvc \"${WINDOWS_SDK_ROOT}/sdk/include/um\" /imsvc \"${WINDOWS_SDK_ROOT}/sdk/include/winrt\"")
set(CMAKE_C_FLAGS_INIT "${_windows_includes}")
set(CMAKE_CXX_FLAGS_INIT "${_windows_includes}")
set(CMAKE_RC_FLAGS_INIT "/I \"${WINDOWS_SDK_ROOT}/sdk/include/um\" /I \"${WINDOWS_SDK_ROOT}/sdk/include/shared\" /I \"${WINDOWS_SDK_ROOT}/crt/include\"")
set(_windows_libs "/libpath:\"${WINDOWS_SDK_ROOT}/crt/lib/x86_64\" /libpath:\"${WINDOWS_SDK_ROOT}/sdk/lib/um/x86_64\" /libpath:\"${WINDOWS_SDK_ROOT}/sdk/lib/ucrt/x86_64\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_windows_libs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_windows_libs}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_windows_libs}")
